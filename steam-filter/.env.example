# Copie para .env e preencha. O .env NAO vai para o Git.
# Chave da Steam Web API: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Seu SteamID64 (17 digitos) OU o nome da sua vanity URL (steamcommunity.com/id/<isso-aqui>)
STEAM_ID=
# Opcionais
STEAM_FILTER_HOST=127.0.0.1
STEAM_FILTER_PORT=8777
